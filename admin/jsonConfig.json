{
    "i18n": true,
    "type": "panel",
    "items": {
        "connectionMode": {
            "type": "select",
            "label": "Connection mode",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "default": "lan",
            "options": [
                { "label": "LAN (local MQTT at printer IP)", "value": "lan" },
                { "label": "Cloud (Bambu account MQTT)", "value": "cloud" }
            ],
            "help": "LAN needs printer IP and LAN access token. Cloud uses your Bambu account (experimental in this fork)."
        },
        "host": {
            "type": "text",
            "label": "Printer IP address",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "visible": {
                "dependsOn": "connectionMode",
                "value": "lan"
            }
        },
        "Password": {
            "type": "password",
            "label": "Access Token",
            "help": "API token from printer network settings - see README for detailed instructions per printer model",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "visible": {
                "dependsOn": "connectionMode",
                "value": "lan"
            }
        },
        "cloudRegion": {
            "type": "select",
            "label": "Cloud region",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "default": "global",
            "options": [
                { "label": "Global (EU/US)", "value": "global" },
                { "label": "China", "value": "china" }
            ],
            "visible": {
                "dependsOn": "connectionMode",
                "value": "cloud"
            }
        },
        "cloudEmail": {
            "type": "text",
            "label": "Bambu account (email)",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "visible": {
                "dependsOn": "connectionMode",
                "value": "cloud"
            }
        },
        "cloudPassword": {
            "type": "password",
            "label": "Bambu password",
            "help": "Used only for login; prefer storing cloudAccessToken after first successful login",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "visible": {
                "dependsOn": "connectionMode",
                "value": "cloud"
            }
        },
        "cloudAccessToken": {
            "type": "password",
            "label": "Cloud access token (optional)",
            "help": "If set, email/password are skipped. Token from Bambu login (~360 days validity)",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "visible": {
                "dependsOn": "connectionMode",
                "value": "cloud"
            }
        },
        "serial": {
            "type": "text",
            "label": "Serial number of device",
            "help": "Device serial number from printer network settings - required for authentication",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "printerModel": {
            "newLine": true,
            "type": "select",
            "label": "Printer Model",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "options": [
                {
                    "label": "A1-Series",
                    "value": "A1-Series"
                },
                {
                    "label": "H2D-Series",
                    "value": "H2D-Series"
                },
                {
                    "label": "P1-Series",
                    "value": "P1-Series"
                },
                {
                    "label": "X1-Series",
                    "value": "X1-Series"
                }
            ],
            "default": "P1-Series",
            "help": "Please select your printer model"
        },
        "requestInterval": {
            "type": "number",
            "label": "Seconds between data polling",
            "help": "Only used for P1x series",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "default": 5,
            "min": 1,
            "max": 36000
        },

        "getDataFiles": {
            "newLine": true,
            "type": "fileSelector",
            "upload": "/",
            "label": "Upload g-code file",
            "help": "Here you can upload files, like g-code, to send to the printer",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "messageBuffer": {
            "type": "number",
            "label": "Message buffer",
            "help": "Only process data every X seconds, reduces CPU load. 0 = every second",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "default": 5,
            "min": 1,
            "max": 36000
        }
    }
}
